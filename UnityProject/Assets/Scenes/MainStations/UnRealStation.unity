--- !u!1001 &420970766
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 1658452411}
    m_Modifications:
    - target: {fileID: 585395312865148023, guid: d3c71176f32c1274b929f3a88695a795,
        type: 3}
      propertyPath: initialText
      value: "<size=40><b>CentComm Notice</b></size>                                                    
        __________________________________\nThis is Barry Newheart from Customer
        Support, following up with your raised item regarding to the potiential Evacuation
        Shuttle Safety Violation. \nI'm afraid that the Evacuation Shuttle is performing
        correctly, the shuttlebombing is to do with the shuttle going off the docking
        position relative to the original Master Design. This Design cannot be updated
        to reflect the current upper docking area due to shuttlebombing ruining any
        newer alterations.\nIf you would like to minimise damage to the station upon
        evacuation, it is recommended that you disassemble the upper corridor prior
        to the shuttle's arrival.\nRegards,\nBarry"
      objectReference: {fileID: 0}
    - target: {fileID: 8692691054828270594, guid: d3c71176f32c1274b929f3a88695a795,
        type: 3}
      propertyPath: sceneId
